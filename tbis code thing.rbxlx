				<Item class="LocalScript" referent="RBXDD1CA0BBD2324B9B98C3F7A2570F946F">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local runService = game:GetService("RunService")

local events = game:GetService("ReplicatedStorage").Events
events.GameLoaded.Event:Wait()
local levelLoadedEvent = events.Levels.LevelLoaded
local portalPlacedEvent = events.Portal.PortalPlaced

local player = game.Players.LocalPlayer

local ui = player.PlayerGui.SpeedrunTimer.Frame

local totalTime = 0
local levelTime = 0
local currentlevel = ""
local portalsPlaced = 0

local timing = false

local function formatTime(t)
	return string.format("%02i", math.floor(t/3600))..":"..string.format("%02i", math.floor((t/60)%60))..":"..string.format("%05.2f", t%60)
end

local function updateUi()
	ui.TotalTime.Text = formatTime(totalTime)
	if ui:FindFirstChild(currentlevel) then
		ui[currentlevel].Text = currentlevel..": "..formatTime(levelTime)
	end
end

levelLoadedEvent.Event:Connect(function(newLevelName, fromMenu)
	if workspace.Map.LevelSettings.MenuLevel.Value then
		timing = false
	elseif fromMenu then
		totalTime = 0
		portalsPlaced = 0
		for i = 0, 9 do
			ui["Level0"..tostring(i)].Text = "Level0"..tostring(i)..": 00:00:00.00"
		end
		timing = true
	else
		timing = true
	end

	currentlevel = newLevelName

	levelTime = 0
end)

runService.RenderStepped:Connect(function(dtime)
	if timing then
		totalTime += dtime
		levelTime += dtime
		updateUi()
	end
end)

portalPlacedEvent.Event:Connect(function()
	portalsPlaced += 1
	ui.PortalsMade.Text = portalsPlaced
end)]]></ProtectedString>
