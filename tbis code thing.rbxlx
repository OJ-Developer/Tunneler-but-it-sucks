					<string name="Name">Interaction</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
					<UniqueId name="UniqueId">0ac38344f78687ba095d4251000010d8</UniqueId>
