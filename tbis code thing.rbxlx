						<string name="ScriptGuid">{61D35C94-662D-49EF-B654-843933B70861}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ViewModel</string>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
						<UniqueId name="UniqueId">5b14d9fd37a8f087061032ef0000e1f0</UniqueId>
					</Properties>
					<Item class="CFrameValue" referent="RBX2E73F084DBE2455C87B7ECCF1F8D7EBA">
						<Properties>
							<CoordinateFrame name="Value">
								<X>1.5</X>
								<Y>-1</Y>
								<Z>-2</Z>
								<R00>1</R00>
								<R01>0</R01>
								<R02>0</R02>
								<R10>0</R10>
								<R11>1</R11>
								<R12>0</R12>
								<R20>0</R20>
								<R21>0</R21>
								<R22>1</R22>
							</CoordinateFrame>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Offset</string>
							<int64 name="SourceAssetId">-1</int64>
